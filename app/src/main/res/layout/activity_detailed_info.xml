<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".DetailedInfoActivity">

    <!-- Page title -->
    <TextView
        android:id="@+id/detailsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="Item Details"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scroll area so the full form still works on smaller screens -->
    <ScrollView
        android:id="@+id/detailsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/detailsTitle"
        app:layout_constraintBottom_toTopOf="@id/actionRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/detailsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Item name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Item name"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/itemNameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="Item name"
                android:inputType="textCapWords"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <!-- Reorder amount -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Reorder amount"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reorderValueEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="0"
                android:inputType="number"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <!-- Quantity is displayed here and updated from the inventory screen -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Quantity on hand"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/qtyValueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="0"
                android:inputType="number"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <!-- Manufacturer is stored in its own lookup table -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Manufacturer"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/manufacturerEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="Manufacturer"
                android:inputType="textCapWords"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <!-- Category keeps similar tools grouped together -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Category"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/categoryEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="Category"
                android:inputType="textCapWords"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <!-- Model number is kept separate from the manufacturer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Model number"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/modelNumberEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="Model number"
                android:inputType="text"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <!-- Serial number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Serial number"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serialEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="Serial number"
                android:inputType="text"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <!-- SCU number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="SCU number"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/scuEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="SCU number"
                android:inputType="text"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <!-- Row and shelf are stored separately so the app can search and
                 report on warehouse positions without parsing one text value. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Warehouse row"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/warehouseRowEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="Row number"
                android:inputType="number"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Warehouse shelf"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/warehouseShelfEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:hint="Shelf number"
                android:inputType="number"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

            <!-- Notes are optional -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Notes"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/notesEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#7D55CC"
                android:gravity="top"
                android:hint="No additional notes for this item."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:paddingBottom="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888" />

        </LinearLayout>
    </ScrollView>

    <!-- Edit and Save stay pinned above the navigation bar -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Edit unlocks the fields while viewing an existing item -->
        <Button
            android:id="@+id/editButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#555555"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <!-- Spacer pushes Save to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Save writes the item details to SQLite -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#7D55CC"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom navigation bar with back button -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#333333"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/backContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/backArrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Go back"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/backLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Spacer keeps the back control aligned to the left -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>