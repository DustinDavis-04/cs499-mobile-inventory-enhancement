<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".DetailedInfoActivity">

    <!-- Page title -->
    <TextView
        android:id="@+id/detailsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="Item Details"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scroll area so the form works on small screens -->
    <ScrollView
        android:id="@+id/detailsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/detailsTitle"
        app:layout_constraintBottom_toTopOf="@id/actionRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/detailsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Item name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Item name"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/itemNameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Item name"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#7D55CC"
                android:paddingBottom="12dp"
                android:inputType="textCapWords" />

            <!-- Reorder amount -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Reorder amount"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/reorderValueEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#7D55CC"
                android:paddingBottom="12dp" />

            <!-- Quantity is displayed here, it is updated on the inventory screen -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Quantity on hand"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/qtyValueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="0"
                android:textColor="#FFFFFF" />

            <!-- Manufacturer (this replaced the old "model" label) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Manufacturer"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/manufacturerEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Manufacturer"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#7D55CC"
                android:paddingBottom="12dp"
                android:inputType="textCapWords" />

            <!-- Serial number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Serial number"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serialEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Serial number"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#7D55CC"
                android:paddingBottom="12dp"
                android:inputType="text" />

            <!-- SCU number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="SCU number"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/scuEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SCU number"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#7D55CC"
                android:paddingBottom="12dp"
                android:inputType="text" />

            <!-- Location is optional -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Location"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/locationEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Not specified"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#7D55CC"
                android:paddingBottom="12dp"
                android:inputType="textCapWords" />

            <!-- Notes are optional -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Notes"
                android:textColor="#BBBBBB"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/notesEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="No additional notes for this item."
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:backgroundTint="#7D55CC"
                android:minLines="3"
                android:gravity="top"
                android:paddingBottom="12dp"
                android:inputType="textMultiLine" />

        </LinearLayout>
    </ScrollView>

    <!-- Edit and Save stay pinned above the nav bar -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Edit unlocks the fields in view mode -->
        <Button
            android:id="@+id/editButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="#555555"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />

        <!-- Spacer pushes Save to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Save writes changes to SQLite (disabled until changes are made) -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="#7D55CC"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />
    </LinearLayout>

    <!-- Bottom nav bar with back -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#333333"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button -->
        <LinearLayout
            android:id="@+id/backContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/backArrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#FFFFFF"
                android:contentDescription="Go back" />

            <TextView
                android:id="@+id/backLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textSize="10sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
