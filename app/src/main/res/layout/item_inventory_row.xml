<?xml version="1.0" encoding="utf-8"?>
<!-- Single inventory row used by the RecyclerView -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Divider between rows -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#555555" />

    <!-- Main row content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Item name and low stock indicator -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Shown only when quantity is at or below reorder threshold -->
            <ImageView
                android:id="@+id/lowStockIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@android:drawable/ic_dialog_alert"
                app:tint="#FF5252"
                android:visibility="gone"
                android:contentDescription="Low stock alert" />

            <!-- Item name, trimmed to one line -->
            <TextView
                android:id="@+id/itemNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Item"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Quantity controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Decrease quantity -->
            <Button
                android:id="@+id/qtyMinusButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="-"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="#444444"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp" />

            <!-- Current quantity -->
            <TextView
                android:id="@+id/qtyText"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFFF" />

            <!-- Increase quantity -->
            <Button
                android:id="@+id/qtyPlusButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="#444444"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Row actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="4dp">

            <!-- Opens the item details screen -->
            <Button
                android:id="@+id/infoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Info"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#2196F3"
                android:background="@android:color/transparent" />

            <!-- Deletes the item after confirmation -->
            <ImageButton
                android:id="@+id/deleteButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_delete"
                app:tint="#D32F2F"
                android:contentDescription="Delete item" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
